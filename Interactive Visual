    <footer class="text-center pt-6 pb-2 border-t border-slate-900 text-xs text-slate-500">
      Simulasi Edukatif Masalah Filsuf Makan (Dining Philosophers Problem) &bull; Konkurensi &amp; Sistem Operasi
    </footer>
  </div>

  <!-- ==================== LOGIKA SIMULASI JAVASCRIPT ==================== -->
  <script>
    /**
     * ============================================================================
     * SIMULASI DINING PHILOSOPHERS PROBLEM
     * ----------------------------------------------------------------------------
     * Struktur kode dibagi menjadi 4 bagian utama agar mudah dipahami:
     * 1. Konfigurasi & State Global
     * 2. Perhitungan Geometri & Rendering SVG Meja Bundar
     * 3. Mesin Simulasi (Naive, Hierarki Sumber Daya, Arbitrator & Deteksi Deadlock)
     * 4. Kontrol UI, Event Listener & Log Aktivitas
     * ============================================================================
     */

    // --------------------------------------------------------------------------
    // 1. KONFIGURASI & STATE GLOBAL
    // --------------------------------------------------------------------------

    const PHILOSOPHER_NAMES = ['Socrates', 'Plato', 'Aristoteles', 'Descartes', 'Kant'];
    const PHILOSOPHER_INITIALS = ['So', 'Pl', 'Ar', 'De', 'Ka'];

    // Pemetaan warna dan label untuk setiap status filsuf
    const STATE_META = {
      THINKING: {
