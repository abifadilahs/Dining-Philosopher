    // Helper: menghasilkan angka bulat acak inklusif antara min dan max
    function randomInt(min, max) {
      return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    // Helper: mengembalikan indeks sumpit kiri dan kanan dari filsuf ke-i
    // (Sumpit #i terletak di sebelah kiri filsuf #i jika menghadap pusat meja)
    function getLeftChopstickId(philId) {
      return philId;
    }

    function getRightChopstickId(philId) {
      return (philId + 4) % 5;
    }

    // Helper: mengembalikan koordinat (x, y) berdasarkan sudut derajat dan radius
    function polarToCartesian(angleDeg, radius) {
      const rad = (angleDeg * Math.PI) / 180;
      return {
        x: CENTER_X + radius * Math.cos(rad),
        y: CENTER_Y + radius * Math.sin(rad),
      };
    }

    // --------------------------------------------------------------------------
    // 2. INISIALISASI STATE & RENDERING SVG MEJA BUNDAR
    // --------------------------------------------------------------------------

    /**
     * Menginisialisasi ulang seluruh data filsuf dan sumpit ke kondisi awal.
     */
    function initState() {
      philosophers = PHILOSOPHER_NAMES.map((name, i) => {
        const angleDeg = -90 + i * 72; // 5 filsuf tersebar merata setiap 72 derajat
        const pos = polarToCartesian(angleDeg, PHILOSOPHER_RADIUS);
        const bowlPos = polarToCartesian(angleDeg, BOWL_RADIUS);
        return {
          id: i,
          name,
          initials: PHILOSOPHER_INITIALS[i],
          angleDeg,
          x: pos.x,
          y: pos.y,
          bowlX: bowlPos.x,
          bowlY: bowlPos.y,
          state: 'THINKING',
          heldChopsticks: [],
          eatCount: 0,
          timer: randomInt(2, 5), // Waktu awal berpikir sebelum lapar
          hasWaiterPermission: false,
        };
      });

      chopsticks = Array.from({ length: 5 }, (_, i) => {
        // Sumpit #i diletakkan tepat di antara Filsuf #i dan Filsuf #(i+1)%5
        const angleDeg = -90 + i * 72 + 36;
        const inner = polarToCartesian(angleDeg, CHOPSTICK_INNER_R);
        const outer = polarToCartesian(angleDeg, CHOPSTICK_OUTER_R);
        const mid = polarToCartesian(angleDeg, (CHOPSTICK_INNER_R + CHOPSTICK_OUTER_R) / 2);
        return {
          id: i,
          angleDeg,
          inner,
          outer,
          mid,
          owner: null, // null berarti tersedia di meja
        };
      });

      isDeadlocked = false;
    }

