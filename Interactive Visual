          <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
            Panel Kontrol Simulasi
          </h2>

          <!-- Pilihan Mode Algoritma -->
          <div class="space-y-2.5">
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400">
              Pilih Mode Algoritma
            </label>
            <div class="space-y-2" id="modeSelector">
              <!-- Mode 1: Naif -->
              <label class="mode-option flex items-start gap-3 p-3 rounded-2xl border border-sky-500/60 bg-sky-500/10 cursor-pointer transition hover:bg-slate-800/80">
