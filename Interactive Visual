    /**
     * Memperbarui seluruh visualisasi SVG dan indikator UI berdasarkan state terbaru.
     */
    function updateVisuals() {
      // 1) Perbarui visual setiap filsuf
      philosophers.forEach((p) => {
        const meta = STATE_META[p.state];
        const group = document.getElementById(`phil-group-${p.id}`);
        const circle = document.getElementById(`phil-circle-${p.id}`);
        const statusText = document.getElementById(`phil-status-${p.id}`);
        const eatText = document.getElementById(`phil-eat-${p.id}`);

        circle.setAttribute('fill', meta.fill);
        circle.setAttribute('stroke', meta.stroke);
        statusText.setAttribute('fill', meta.text);
        statusText.textContent = meta.label;
        eatText.textContent = `Makan: ${p.eatCount} kali`;

        // Atur efek animasi sesuai status
        group.classList.remove('deadlock-pulse', 'eating-glow');
        if (p.state === 'DEADLOCK') {
          group.classList.add('deadlock-pulse');
        } else if (p.state === 'EATING') {
          group.classList.add('eating-glow');
        }
      });

      // 2) Perbarui visual & pergeseran posisi setiap sumpit
      chopsticks.forEach((c) => {
        const group = document.getElementById(`chopstick-group-${c.id}`);
        const line = document.getElementById(`chopstick-line-${c.id}`);
        const badge = document.getElementById(`chopstick-badge-${c.id}`);

        if (c.owner === null) {
          // Sumpit bebas: kembali ke posisi semula di meja
          group.style.transform = 'translate(0px, 0px)';
          line.setAttribute('stroke', '#94a3b8');
          line.setAttribute('stroke-width', '5');
          badge.setAttribute('stroke', '#475569');
          badge.setAttribute('fill', '#0f172a');
        } else {
          // Sumpit sedang dipegang oleh filsuf: geser ke arah filsuf tersebut
          const ownerPhil = philosophers[c.owner];
          const ownerMeta = STATE_META[ownerPhil.state];

          // Hitung vektor pergeseran 34% menuju posisi filsuf yang memegang sumpit
          const dx = (ownerPhil.x - c.mid.x) * 0.34;
          const dy = (ownerPhil.y - c.mid.y) * 0.34;

          group.style.transform = `translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px)`;
          line.setAttribute('stroke', ownerMeta.stroke);
          line.setAttribute('stroke-width', '6.5');
          badge.setAttribute('stroke', ownerMeta.stroke);
          badge.setAttribute('fill', ownerMeta.fill);
        }
      });

      // 3) Perbarui indikator Pelayan (Arbitrator) jika mode tersebut aktif
      if (currentMode === 'arbitrator') {
        const activeWaiters = philosophers.filter((p) => p.hasWaiterPermission).length;
        waiterBadge.classList.remove('hidden');
        waiterBadge.classList.add('flex');
        waiterCountEl.textContent = `${activeWaiters} / 4`;
      } else {
        waiterBadge.classList.add('hidden');
        waiterBadge.classList.remove('flex');
      }
    }

    // --------------------------------------------------------------------------
    // 3. MESIN SIMULASI & ALGORITMA KONKURENSI
    // --------------------------------------------------------------------------

    /**
     * Menentukan urutan sumpit yang harus diambil oleh filsuf berdasarkan mode algoritma.
     */
    function getChopstickOrder(philId) {
      const left = getLeftChopstickId(philId);
      const right = getRightChopstickId(philId);

      if (currentMode === 'hierarchy') {
        // Solusi Hierarki Sumber Daya: selalu ambil nomor sumpit yang lebih kecil dulu
        return left < right ? [left, right] : [right, left];
      }

      // Mode Naif & Mode Pelayan: ambil sumpit kiri dulu, lalu kanan
      return [left, right];
    }

    /**
     * Memeriksa apakah sistem mengalami Deadlock:
     * Semua 5 filsuf dalam keadaan LAPAR, masing-masing memegang tepat 1 sumpit,
     * dan tidak ada satu pun sumpit bebas yang tersisa di meja.
     */
    function checkDeadlock() {
      const allHungryWithOneStick = philosophers.every(
        (p) => p.state === 'HUNGRY' && p.heldChopsticks.length === 1
      );
      const noFreeChopsticks = chopsticks.every((c) => c.owner !== null);

      if (allHungryWithOneStick && noFreeChopsticks) {
        triggerDeadlockState();
        return true;
      }
      return false;
    }

    /**
     * Mengubah seluruh sistem ke status DEADLOCK dan menghentikan loop simulasi.
     */
    function triggerDeadlockState() {
      isDeadlocked = true;
      stopSimulationLoop();

      philosophers.forEach((p) => {
        p.state = 'DEADLOCK';
      });

      updateVisuals();
      setStatusBanner(
        'deadlock',
        'DEADLOCK TERDETEKSI!',
        'Kelima filsuf masing-masing memegang 1 sumpit dan saling menunggu tanpa henti. Klik Reset atau ganti algoritma.'
      );
      addLog(
        'DEADLOCK TERDETEKSI! Semua filsuf memegang sumpit kiri dan saling menunggu sumpit kanan. Sistem macet total!',
        'deadlock'
      );
    }

    /**
     * Menjalankan 1 langkah (tick) simulasi untuk seluruh filsuf.
     */
    function simulationTick() {
      if (isDeadlocked) return;

      // Acak urutan pemrosesan filsuf di setiap tick agar adil (tidak bias indeks)
      const order = [0, 1, 2, 3, 4].sort(() => Math.random() - 0.5);

      for (const id of order) {
        const p = philosophers[id];

        // --- KONDISI 1: SEDANG BERPIKIR ---
        if (p.state === 'THINKING') {
          p.timer -= 1;
          if (p.timer <= 0) {
            p.state = 'HUNGRY';
            addLog(`${p.name} selesai berpikir dan mulai merasa lapar.`, 'hungry');
          }
          continue;
        }

        // --- KONDISI 2: SEDANG LAPAR (MENCOBA MENGAMBIL SUMPIT) ---
        if (p.state === 'HUNGRY') {
          // Khusus Mode Pelayan (Arbitrator): cek izin pelayan (maksimal 4 filsuf)
          if (currentMode === 'arbitrator' && !p.hasWaiterPermission) {
            const grantedCount = philosophers.filter((x) => x.hasWaiterPermission).length;
            if (grantedCount < 4) {
              p.hasWaiterPermission = true;
              addLog(`Pelayan memberi izin kepada ${p.name} (${grantedCount + 1}/4 aktif).`, 'info');
            } else {
              // Menunggu giliran dari pelayan tanpa mengambil sumpit apa pun
              continue;
            }
          }

          const [firstStickId, secondStickId] = getChopstickOrder(p.id);

          // Belum memegang sumpit -> coba ambil sumpit pertama
          if (p.heldChopsticks.length === 0) {
            if (chopsticks[firstStickId].owner === null) {
              chopsticks[firstStickId].owner = p.id;
              p.heldChopsticks.push(firstStickId);
              addLog(`${p.name} mengambil sumpit #${firstStickId}.`, 'pickup');
            }
          }
          // Sudah memegang 1 sumpit -> coba ambil sumpit kedua
          else if (p.heldChopsticks.length === 1) {
            if (chopsticks[secondStickId].owner === null) {
              chopsticks[secondStickId].owner = p.id;
              p.heldChopsticks.push(secondStickId);
              p.state = 'EATING';
              p.eatCount += 1;
              p.timer = randomInt(3, 5); // Durasi makan
              addLog(
                `${p.name} mengambil sumpit #${secondStickId} dan mulai makan! (Makan ke-${p.eatCount})`,
                'eating'
              );
            }
          }
          continue;
        }

        // --- KONDISI 3: SEDANG MAKAN ---
        if (p.state === 'EATING') {
          p.timer -= 1;
          if (p.timer <= 0) {
            const releasedIds = [...p.heldChopsticks];
            releasedIds.forEach((stickId) => {
              chopsticks[stickId].owner = null;
            });
            p.heldChopsticks = [];

            // Kembalikan izin pelayan jika menggunakan Mode Arbitrator
            if (p.hasWaiterPermission) {
              p.hasWaiterPermission = false;
            }

            p.state = 'THINKING';
            p.timer = randomInt(3, 6); // Durasi berpikir kembali
            addLog(
              `${p.name} selesai makan, meletakkan sumpit #${releasedIds[0]} & #${releasedIds[1]}, lalu berpikir.`,
              'thinking'
            );
          }
        }
      }

      // Perbarui tampilan visual setelah semua filsuf diproses
      updateVisuals();

      // Cek apakah terjadi Deadlock
      checkDeadlock();
    }

    /**
     * Mendemonstrasikan Deadlock secara instan:
     * Mengalihkan ke Mode Naif, membuat semua filsuf lapar bersamaan, lalu mengambil sumpit kiri.
     */
    function simulateInstantDeadlock() {
      stopSimulationLoop();
      clearTimeout(deadlockTimeoutId);

      // Pastikan radio button berpindah ke Mode Naif
      currentMode = 'naive';
      const naiveRadio = document.querySelector('input[name="algorithmMode"][value="naive"]');
      if (naiveRadio) naiveRadio.checked = true;
      updateModeSelectorUI();

      // Reset ke keadaan bersih
      initState();
      updateVisuals();

      addLog('--- Memulai demonstrasi Deadlock instan (Mode Naif) ---', 'info');

      // Langkah 1: Semua filsuf merasa lapar secara bersamaan
      philosophers.forEach((p) => {
        p.state = 'HUNGRY';
      });
      updateVisuals();
      setStatusBanner(
        'running',
        'Mensimulasikan Deadlock...',
        'Kelima filsuf merasa lapar di saat yang bersamaan dan bersiap mengambil sumpit kiri.'
      );
      addLog('Kelima filsuf merasa lapar pada saat yang bersamaan!', 'hungry');

      // Langkah 2 (setelah jeda singkat agar animasi terlihat jelas): Semua mengambil sumpit kiri
      deadlockTimeoutId = setTimeout(() => {
        philosophers.forEach((p) => {
          const leftId = getLeftChopstickId(p.id);
          chopsticks[leftId].owner = p.id;
          p.heldChopsticks = [leftId];
        });
        updateVisuals();
        addLog('Semua filsuf serentak mengambil sumpit kirinya (#0, #1, #2, #3, #4).', 'pickup');

        // Langkah 3: Picu status Deadlock
        deadlockTimeoutId = setTimeout(() => {
          checkDeadlock();
        }, 450);
      }, 500);
    }

    // --------------------------------------------------------------------------
    // 4. KONTROL UI, BANNER STATUS & LOG AKTIVITAS
    // --------------------------------------------------------------------------

    function startSimulationLoop() {
      if (isDeadlocked) {
        // Jika sedang deadlock dan user menekan Mulai, reset otomatis terlebih dahulu
        resetSimulation(false);
      }
      if (isRunning) return;

      isRunning = true;
      tickIntervalId = setInterval(simulationTick, tickDelayMs);
      updatePlayPauseButton();
      setStatusBanner(
        'running',
        'Simulasi Berjalan (Normal)',
        `Algoritma aktif: ${getModeDisplayName(currentMode)}. Amati pergerakan sumpit dan status tiap filsuf.`
      );
      addLog(`Simulasi dijalankan (${getModeDisplayName(currentMode)}).`, 'info');
    }

    function stopSimulationLoop() {
      isRunning = false;
      if (tickIntervalId !== null) {
        clearInterval(tickIntervalId);
        tickIntervalId = null;
      }
      updatePlayPauseButton();
    }

    function pauseSimulation() {
      stopSimulationLoop();
      if (!isDeadlocked) {
        setStatusBanner(
          'idle',
          'Simulasi Dijeda',
          'Tekan tombol Mulai untuk melanjutkan simulasi dari posisi terakhir.'
        );
        addLog('Simulasi dijeda oleh pengguna.', 'info');
      }
    }

    function resetSimulation(logMessage = true) {
      stopSimulationLoop();
      clearTimeout(deadlockTimeoutId);
      initState();
      updateVisuals();
      setStatusBanner(
        'idle',
        'Sistem Siap',
        'Seluruh filsuf kembali berpikir dan semua sumpit tersedia di meja.'
      );
      if (logMessage) {
        addLog('Simulasi direset ke kondisi awal.', 'info');
      }
    }

    function updatePlayPauseButton() {
      if (isRunning) {
        btnPlayPauseText.textContent = 'Jeda';
        iconPlay.classList.add('hidden');
        iconPause.classList.remove('hidden');
        btnPlayPause.classList.remove('bg-sky-500', 'hover:bg-sky-400');
        btnPlayPause.classList.add('bg-amber-400', 'hover:bg-amber-300');
      } else {
        btnPlayPauseText.textContent = 'Mulai';
        iconPlay.classList.remove('hidden');
        iconPause.classList.add('hidden');
        btnPlayPause.classList.remove('bg-amber-400', 'hover:bg-amber-300');
        btnPlayPause.classList.add('bg-sky-500', 'hover:bg-sky-400');
      }
    }

    function getModeDisplayName(mode) {
      if (mode === 'naive') return 'Mode Naif (Rawan Deadlock)';
      if (mode === 'hierarchy') return 'Hierarki Sumber Daya';
      return 'Solusi Pelayan (Arbitrator)';
    }

    function updateModeSelectorUI() {
      const labels = document.querySelectorAll('.mode-option');
      labels.forEach((label) => {
        const radio = label.querySelector('input[type="radio"]');
        if (radio.checked) {
          label.classList.remove('border-slate-800', 'bg-slate-950/60');
          label.classList.add('border-sky-500/60', 'bg-sky-500/10');
        } else {
          label.classList.remove('border-sky-500/60', 'bg-sky-500/10');
          label.classList.add('border-slate-800', 'bg-slate-950/60');
        }
      });

      // Perbarui pil mode aktif di atas meja
      activeModePill.textContent = `Mode: ${getModeDisplayName(currentMode)}`;
      if (currentMode === 'naive') {
        activeModePill.className =
          'text-xs font-medium px-3 py-1 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/25';
      } else {
        activeModePill.className =
          'text-xs font-medium px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/25';
      }
    }

    /**
     * Memperbarui banner status di bagian atas halaman.
     */
    function setStatusBanner(type, title, subtitle) {
      statusTitle.textContent = title;
      statusSubtitle.textContent = subtitle;

      statusBanner.className =
        'rounded-2xl border px-5 py-3.5 flex flex-col sm:flex-row items-center justify-between gap-3 transition-all duration-300 shadow-lg ';

      if (type === 'deadlock') {
        statusBanner.className += 'border-red-500/70 bg-red-950/70 animate-pulse';
        statusDot.className = 'w-3 h-3 rounded-full bg-red-500 shrink-0 shadow-[0_0_10px_#ef4444]';
        statusTitle.className = 'text-sm font-extrabold text-red-300 tracking-wide';
        statusSubtitle.className = 'text-xs text-red-200/90';
      } else if (type === 'running') {
        statusBanner.className += 'border-emerald-500/40 bg-emerald-950/30';
        statusDot.className = 'w-3 h-3 rounded-full bg-emerald-400 shrink-0 animate-pulse';
        statusTitle.className = 'text-sm font-bold text-emerald-300';
        statusSubtitle.className = 'text-xs text-slate-300';
      } else {
        statusBanner.className += 'border-slate-800 bg-slate-900/80';
        statusDot.className = 'w-3 h-3 rounded-full bg-sky-400 shrink-0';
        statusTitle.className = 'text-sm font-bold text-slate-100';
        statusSubtitle.className = 'text-xs text-slate-400';
      }
    }

    /**
     * Menambahkan entri baru ke panel Log Aktivitas Real-time dengan timestamp singkat.
     */
    function addLog(message, category = 'info') {
      const now = new Date();
      const timeStr = now.toTimeString().slice(0, 8); // Format JJ:MM:DD

      const colorMap = {
        thinking: 'text-sky-300',
        hungry: 'text-amber-300',
        pickup: 'text-slate-300',
        eating: 'text-emerald-300 font-semibold',
        deadlock: 'text-red-300 font-bold bg-red-950/60 border border-red-500/30 px-2 py-1.5 rounded-lg',
        info: 'text-slate-400',
      };

      const entry = document.createElement('div');
      entry.className = `leading-relaxed ${colorMap[category] || 'text-slate-300'}`;
      entry.innerHTML = `<span class="text-slate-500 mr-1.5">[${timeStr}]</span>${message}`;

      activityLogEl.appendChild(entry);

      // Batasi jumlah maksimal baris log agar performa browser tetap ringan
      while (activityLogEl.children.length > 100) {
        activityLogEl.removeChild(activityLogEl.firstChild);
      }

      // Gulir otomatis ke pesan terbaru
      activityLogEl.scrollTop = activityLogEl.scrollHeight;
    }

    // --------------------------------------------------------------------------
    // EVENT LISTENERS
    // --------------------------------------------------------------------------

    btnPlayPause.addEventListener('click', () => {
      if (isRunning) {
        pauseSimulation();
      } else {
        startSimulationLoop();
      }
    });

    btnReset.addEventListener('click', () => {
      resetSimulation(true);
    });

    btnSimulateDeadlock.addEventListener('click', () => {
      simulateInstantDeadlock();
    });

    btnClearLog.addEventListener('click', () => {
      activityLogEl.innerHTML = '';
      addLog('Log aktivitas dibersihkan.', 'info');
    });

    // Pergantian Mode Algoritma
    document.querySelectorAll('input[name="algorithmMode"]').forEach((radio) => {
      radio.addEventListener('change', (e) => {
        currentMode = e.target.value;
        updateModeSelectorUI();
        resetSimulation(false);
        addLog(`Mode algoritma diubah ke: ${getModeDisplayName(currentMode)}.`, 'info');
      });
    });

    // Pengaturan Kecepatan Simulasi via Slider
    speedSlider.addEventListener('input', (e) => {
      const level = Number(e.target.value);
      const cfg = SPEED_CONFIG[level];
      tickDelayMs = cfg.ms;
      speedLabel.textContent = cfg.label;

      // Jika simulasi sedang berjalan, perbarui interval kecepatan secara langsung
      if (isRunning) {
        clearInterval(tickIntervalId);
        tickIntervalId = setInterval(simulationTick, tickDelayMs);
      }
    });

    // --------------------------------------------------------------------------
    // INISIALISASI AWAL SAAT HALAMAN DIMUAT
    // --------------------------------------------------------------------------
    window.addEventListener('DOMContentLoaded', () => {
      initState();
      buildSvgElements();
      updateVisuals();
      updateModeSelectorUI();
      addLog('Selamat datang! Pilih mode algoritma lalu tekan "Mulai" untuk mengamati simulasi.', 'info');
    });
  </script>
</body>
</html>
